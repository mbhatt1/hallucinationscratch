\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Receiver Operating Characteristic (ROC) Curve.} The ROC curve plots true positive rate against false positive rate across all classification thresholds. PCIB achieves AUROC of 0.8017, substantially exceeding the random baseline (diagonal, AUC=0.50). The curve's pronounced convexity indicates strong discriminative ability across the entire threshold range. Evaluated on $n=200$ balanced dataset.}}{7}{figure.caption.2}\protected@file@percent }
\newlabel{fig:roc}{{1}{7}{\textbf {Receiver Operating Characteristic (ROC) Curve.} The ROC curve plots true positive rate against false positive rate across all classification thresholds. PCIB achieves AUROC of 0.8017, substantially exceeding the random baseline (diagonal, AUC=0.50). The curve's pronounced convexity indicates strong discriminative ability across the entire threshold range. Evaluated on $n=200$ balanced dataset}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Precision-Recall (PR) Curve.} The PR curve demonstrates precision-recall tradeoffs across classification thresholds. PCIB achieves AUPRC of 0.7387, well above the balanced dataset baseline of 0.50 (horizontal dashed line). The sustained precision above 0.5 across most recall values indicates robust performance. For balanced datasets, AUPRC baseline equals the positive class proportion (50\%).}}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:pr}{{2}{8}{\textbf {Precision-Recall (PR) Curve.} The PR curve demonstrates precision-recall tradeoffs across classification thresholds. PCIB achieves AUPRC of 0.7387, well above the balanced dataset baseline of 0.50 (horizontal dashed line). The sustained precision above 0.5 across most recall values indicates robust performance. For balanced datasets, AUPRC baseline equals the positive class proportion (50\%)}{figure.caption.3}{}}
\citation{saito2015precision}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Score Distributions by Ground Truth Class.} Gaussian approximations of risk score distributions for hallucinated content (red) vs. factual content (green). The separation margin of 0.35 between class means (0.742 vs. 0.390) demonstrates clear discriminative ability. The optimal threshold at 0.516 (vertical dashed line) maximizes Youden's J statistic, achieving 75\% sensitivity and 82\% specificity.}}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:distributions}{{3}{9}{\textbf {Score Distributions by Ground Truth Class.} Gaussian approximations of risk score distributions for hallucinated content (red) vs. factual content (green). The separation margin of 0.35 between class means (0.742 vs. 0.390) demonstrates clear discriminative ability. The optimal threshold at 0.516 (vertical dashed line) maximizes Youden's J statistic, achieving 75\% sensitivity and 82\% specificity}{figure.caption.4}{}}
